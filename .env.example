# ==========================================
# 🌌 Singularity - Environment Configuration
# ==========================================

# Server Network
HOST=0.0.0.0
PORT=3000

# SFTP Micro-Server for Antigravity IDE / VS Code
SFTP_PORT=2022

# Security & Authentication
JWT_SECRET=super_secret_jwt_key_singularity_change_in_production
SESSION_TIMEOUT_HOURS=24

# Initial Administrator Credentials (used only on first boot)
DEFAULT_ADMIN_USER=admin
DEFAULT_ADMIN_PASSWORD=admin

# File Storage
DATA_DIR=./data

# Content Catalog Providers
# Modrinth & PaperMC are free and open (no API key needed)
# CurseForge API Key (Optional - required only if you want CurseForge mods/modpacks)
CURSEFORGE_API_KEY=
