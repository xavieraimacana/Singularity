{
  "name": "singularity",
  "version": "0.1.0-alpha",
  "description": "The Next-Generation Minecraft Server Orchestrator & Mission Control Suite",
  "author": "NebulaX Studio",
  "license": "MIT",
  "type": "module",
  "main": "dist/delivery/desktop/main.js",
  "scripts": {
    "dev": "tsx watch src/delivery/http/server.ts",
    "dev:desktop": "electron .",
    "build:server": "tsc -p tsconfig.server.json && node -e \"const fs=require('fs'); fs.mkdirSync('dist/delivery/desktop/assets', {recursive:true}); fs.cpSync('src/delivery/desktop/assets', 'dist/delivery/desktop/assets', {recursive:true});\"",
    "build:web": "npm --prefix src/delivery/web-dashboard run build",
    "build": "npm run build:server && npm run build:web",
    "start": "node dist/delivery/http/server.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "lint": "tsc --noEmit"
  },
  "dependencies": {
    "@fastify/cors": "^10.0.2",
    "@fastify/jwt": "^9.0.4",
    "@fastify/static": "^8.1.1",
    "@fastify/websocket": "^11.0.2",
    "dotenv": "^16.4.7",
    "fastify": "^5.2.1",
    "pidusage": "^3.0.2",
    "ssh2": "^1.16.0",
    "tree-kill": "^1.2.2",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/node": "^22.13.4",
    "@types/pidusage": "^2.0.5",
    "@types/ssh2": "^1.15.4",
    "@types/ws": "^8.18.2",
    "electron": "^34.2.0",
    "tsx": "^4.19.3",
    "typescript": "^5.7.3",
    "vitest": "^3.0.6"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
